<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%">
  <defs>
    <linearGradient id="michat-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#18181B"/>
      <stop offset="100%" stop-color="#09090B"/>
    </linearGradient>
    <linearGradient id="card-grad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#27272A" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#18181B" stop-opacity="0.9"/>
    </linearGradient>
    <linearGradient id="bubble-user" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#C85A32"/>
      <stop offset="100%" stop-color="#9C3A1A"/>
    </linearGradient>
    <filter id="subtle-shadow" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="20" stdDeviation="25" flood-color="#000000" flood-opacity="0.6"/>
    </filter>
  </defs>

  <!-- Canvas Background -->
  <rect width="1200" height="800" fill="url(#michat-bg)"/>
  
  <!-- Subtle Grid Lines -->
  <g stroke="#ffffff" stroke-opacity="0.04" stroke-width="1">
    <line x1="0" y1="200" x2="1200" y2="200"/>
    <line x1="0" y1="400" x2="1200" y2="400"/>
    <line x1="0" y1="600" x2="1200" y2="600"/>
    <line x1="300" y1="0" x2="300" y2="800"/>
    <line x1="600" y1="0" x2="600" y2="800"/>
    <line x1="900" y1="0" x2="900" y2="800"/>
  </g>

  <!-- Back Glow -->
  <circle cx="600" cy="400" r="280" fill="#C85A32" opacity="0.08" filter="blur(60px)"/>

  <!-- Mobile Phone Mockup Body -->
  <g transform="translate(420, 90)" filter="url(#subtle-shadow)">
    <!-- Device Frame Outer -->
    <rect x="0" y="0" width="360" height="620" rx="44" fill="#121214" stroke="#3F3F46" stroke-width="2"/>
    <!-- Screen Inner -->
    <rect x="10" y="10" width="340" height="600" rx="36" fill="#18181B"/>
    
    <!-- Notch / Dynamic Island -->
    <rect x="130" y="22" width="100" height="24" rx="12" fill="#09090B"/>
    <circle cx="210" cy="34" r="4" fill="#27272A"/>

    <!-- App Header -->
    <g transform="translate(30, 70)">
      <circle cx="20" cy="20" r="18" fill="#27272A"/>
      <text x="20" y="25" fill="#E4E4E7" font-family="sans-serif" font-size="13" font-weight="600" text-anchor="middle">S</text>
      <text x="50" y="18" fill="#F4F4F5" font-family="sans-serif" font-size="15" font-weight="600">Dev Sync Team</text>
      <circle cx="53" cy="28" r="3" fill="#22C55E"/>
      <text x="62" y="31" fill="#71717A" font-family="sans-serif" font-size="10">Active · E2EE Encrypted</text>
    </g>

    <!-- Chat Messages -->
    <g transform="translate(25, 140)">
      <!-- Incoming Message 1 -->
      <rect x="0" y="0" width="220" height="54" rx="16" fill="#27272A"/>
      <text x="16" y="24" fill="#E4E4E7" font-family="sans-serif" font-size="12">Deployed WebSocket sync v2.</text>
      <text x="16" y="42" fill="#71717A" font-family="sans-serif" font-size="10">Sub-45ms latency confirmed ✓</text>

      <!-- Outgoing Message (Sabith) -->
      <rect x="90" y="70" width="220" height="64" rx="16" fill="url(#bubble-user)"/>
      <text x="106" y="94" fill="#FFFFFF" font-family="sans-serif" font-size="12" font-weight="500">Isolate parsing active.</text>
      <text x="106" y="112" fill="#FED7AA" font-family="sans-serif" font-size="11">Zero dropped frames on 120Hz.</text>
      <text x="290" y="125" fill="#FED7AA" font-family="sans-serif" font-size="9" text-anchor="end">13:42 ✓✓</text>

      <!-- Incoming Message 2 with Code block -->
      <rect x="0" y="150" width="260" height="90" rx="16" fill="#27272A"/>
      <text x="16" y="174" fill="#A1A1AA" font-family="sans-serif" font-size="11">Benchmark telemetry payload:</text>
      <rect x="16" y="184" width="228" height="42" rx="8" fill="#121214"/>
      <text x="26" y="202" fill="#38BDF8" font-family="monospace" font-size="10">stream.listen((event) =&gt; {</text>
      <text x="26" y="216" fill="#4ADE80" font-family="monospace" font-size="10">  cache.dispatch(event);</text>
      <text x="26" y="224" fill="#38BDF8" font-family="monospace" font-size="10">});</text>

      <!-- Outgoing Message 3 -->
      <rect x="120" y="255" width="190" height="44" rx="16" fill="url(#bubble-user)"/>
      <text x="136" y="282" fill="#FFFFFF" font-family="sans-serif" font-size="12" font-weight="500">Shipped to production 🚀</text>
    </g>

    <!-- Bottom Input Bar -->
    <g transform="translate(20, 520)">
      <rect x="0" y="0" width="300" height="48" rx="24" fill="#27272A" stroke="#3F3F46" stroke-width="1"/>
      <text x="20" y="30" fill="#71717A" font-family="sans-serif" font-size="13">Type a message...</text>
      <circle cx="270" cy="24" r="16" fill="#C85A32"/>
      <path d="M265 24 L273 24 M270 20 L274 24 L270 28" stroke="#FFFFFF" stroke-width="2" fill="none" stroke-linecap="round"/>
    </g>
  </g>

  <!-- Left Floating Metadata Card -->
  <g transform="translate(80, 240)" filter="url(#subtle-shadow)">
    <rect x="0" y="0" width="280" height="180" rx="18" fill="#18181B" stroke="#27272A" stroke-width="1"/>
    <text x="24" y="40" fill="#71717A" font-family="sans-serif" font-size="11" letter-spacing="1">ARCHITECTURAL METRICS</text>
    <text x="24" y="75" fill="#F4F4F5" font-family="sans-serif" font-size="28" font-weight="700">&lt; 45ms</text>
    <text x="24" y="96" fill="#A1A1AA" font-family="sans-serif" font-size="12">End-to-end sync latency</text>
    
    <line x1="24" y1="115" x2="256" y2="115" stroke="#27272A"/>
    
    <text x="24" y="145" fill="#C85A32" font-family="sans-serif" font-size="18" font-weight="600">120 FPS</text>
    <text x="120" y="145" fill="#A1A1AA" font-family="sans-serif" font-size="12">Smooth isolate rendering</text>
  </g>

  <!-- Right Floating Tech Stack Card -->
  <g transform="translate(840, 320)" filter="url(#subtle-shadow)">
    <rect x="0" y="0" width="280" height="220" rx="18" fill="#18181B" stroke="#27272A" stroke-width="1"/>
    <text x="24" y="38" fill="#71717A" font-family="sans-serif" font-size="11" letter-spacing="1">MOBILE STACK</text>
    
    <g transform="translate(24, 60)">
      <rect x="0" y="0" width="85" height="28" rx="14" fill="#27272A"/>
      <text x="42" y="18" fill="#E4E4E7" font-family="sans-serif" font-size="11" text-anchor="middle">Flutter 3</text>
      
      <rect x="95" y="0" width="70" height="28" rx="14" fill="#27272A"/>
      <text x="130" y="18" fill="#E4E4E7" font-family="sans-serif" font-size="11" text-anchor="middle">Dart</text>

      <rect x="0" y="40" width="115" height="28" rx="14" fill="#27272A"/>
      <text x="57" y="58" fill="#E4E4E7" font-family="sans-serif" font-size="11" text-anchor="middle">WebSockets</text>

      <rect x="125" y="40" width="95" height="28" rx="14" fill="#27272A"/>
      <text x="172" y="58" fill="#E4E4E7" font-family="sans-serif" font-size="11" text-anchor="middle">Riverpod</text>

      <rect x="0" y="80" width="130" height="28" rx="14" fill="#27272A"/>
      <text x="65" y="98" fill="#E4E4E7" font-family="sans-serif" font-size="11" text-anchor="middle">SQLite Local Bus</text>
    </g>

    <text x="24" y="195" fill="#22C55E" font-family="sans-serif" font-size="12">● E2E Encrypted Protocol</text>
  </g>
</svg>
